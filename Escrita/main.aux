\@writefile{lof}{\contentsline {figure}{\numberline {3.8}{\ignorespaces Mosaico da expansão térmica para misturas de DPPC/DSPC sob diferentes concentrações de colesterol (0\%, 3\% e 30\% em mol). Observa-se a supressão progressiva da transição de fase cooperativa em função do aumento da saturação por esterol.\relax }}{30}{figure.caption.11}\protected@file@percent }
\newlabel{fig:mosaico_chol_global}{{3.8}{30}{Mosaico da expansão térmica para misturas de DPPC/DSPC sob diferentes concentrações de colesterol (0\%, 3\% e 30\% em mol). Observa-se a supressão progressiva da transição de fase cooperativa em função do aumento da saturação por esterol.\relax }{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.9}{\ignorespaces Área média por molécula para o sistema com 30\% de colesterol. O efeito condensador lineariza a expansão térmica e anula a influência do comprimento da cadeia acílica, resultando na convergência das curvas para as diferentes misturas de DPPC/DSPC.\relax }}{31}{figure.caption.12}\protected@file@percent }
\newlabel{fig:apl_chol_30}{{3.9}{31}{Área média por molécula para o sistema com 30\% de colesterol. O efeito condensador lineariza a expansão térmica e anula a influência do comprimento da cadeia acílica, resultando na convergência das curvas para as diferentes misturas de DPPC/DSPC.\relax }{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.10}{\ignorespaces Mosaico termotrópico para as misturas binárias de DPPC/DSPC em meio salino fisiológico (0,15 M NaCl). Observa-se que a adição de alta concentração de colesterol (40\% em mol) sobrepõe-se à coordenação iônica interfacial, anulando a cooperatividade em todas as proporções estequiométricas.\relax }}{32}{figure.caption.13}\protected@file@percent }
\newlabel{fig:mosaico_salino}{{3.10}{32}{Mosaico termotrópico para as misturas binárias de DPPC/DSPC em meio salino fisiológico (0,15 M NaCl). Observa-se que a adição de alta concentração de colesterol (40\% em mol) sobrepõe-se à coordenação iônica interfacial, anulando a cooperatividade em todas as proporções estequiométricas.\relax }{figure.caption.13}{}}
